rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBetterRankingUpdate(nextData, prevData) {
      return nextData.score > prevData.score
        || (nextData.score == prevData.score && nextData.pulledWeeds > prevData.pulledWeeds)
        || (
          nextData.score == prevData.score
          && nextData.pulledWeeds == prevData.pulledWeeds
          && nextData.mistakes < prevData.mistakes
        );
    }

    function isValidRankingEntry(data) {
      return data.keys().hasAll([
          'playerName',
          'score',
          'pulledWeeds',
          'maxCombo',
          'mistakes',
          'durationSeconds',
          'portraitId',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'playerName',
          'score',
          'pulledWeeds',
          'maxCombo',
          'mistakes',
          'durationSeconds',
          'portraitId',
          'createdAt',
          'uid'
        ])
        && data.playerName is string
        && data.playerName.size() >= 1
        && data.playerName.size() <= 12
        && data.score is int
        && data.score >= 0
        && data.score <= 300
        && data.pulledWeeds is int
        && data.pulledWeeds >= 0
        && data.pulledWeeds <= 300
        && data.maxCombo is int
        && data.maxCombo >= 0
        && data.maxCombo <= 300
        && data.mistakes is int
        && data.mistakes >= 0
        && data.mistakes <= 300
        && data.durationSeconds is int
        && data.durationSeconds == 30
        && data.portraitId is string
        && data.portraitId in ['chiikawa', 'hachiware', 'usagi', 'camera']
        && data.createdAt == request.time
        && (!('uid' in data) || (request.auth != null && data.uid is string && data.uid == request.auth.uid));
    }

    // 30-second weeding challenge leaderboard (non-PII public game scores; same-name updates only allowed for higher records)
    match /rankings/{entryId} {
      allow get: if isValidId(entryId)
        && (resource == null || (resource.data.score >= 0 && resource.data.score <= 300));
      allow list: if resource.data.score >= 0 && resource.data.score <= 300;
      allow create: if isValidId(entryId) && isValidRankingEntry(incoming());
      allow update: if isValidId(entryId)
        && isValidRankingEntry(incoming())
        && incoming().playerName == existing().playerName
        && incoming().durationSeconds == existing().durationSeconds
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'score',
          'pulledWeeds',
          'maxCombo',
          'mistakes',
          'portraitId',
          'createdAt',
          'uid'
        ])
        && isBetterRankingUpdate(incoming(), existing());
      allow delete: if false;
    }
  }
}
